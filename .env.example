# Booking (Cal.com). Nothing here is required and nothing here is a secret: the booking
# functions use Cal.com's public API without a key, and the defaults are in
# netlify/functions/_lib/config.ts.
# Set either name only to point the site at another Cal.com account or event type without a
# code change: in Netlify under Site configuration > Environment variables (then redeploy),
# or in a local .env file for `netlify dev`. .env is git-ignored.

# Optional. The Cal.com username, the first part of cal.com/<username>/<event slug>.
CAL_USERNAME=

# Optional. The event type's slug, the second part of that address.
CAL_EVENT_SLUG=
