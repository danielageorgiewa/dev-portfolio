# Booking (Google Calendar). Copy this file to .env for local work with `netlify dev`, and set
# the same four names in Netlify: Site configuration > Environment variables.
# Never commit real values. .env is git-ignored.
# Until the first four are set, the site shows the email link in place of the booking widget.
# Setup steps are in README.md, "Google setup".

# OAuth client ID from Google Cloud (ends in .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=

# OAuth client secret from the same client.
GOOGLE_CLIENT_SECRET=

# Long-lived refresh token. Run `node scripts/google-auth.mjs` once to get it.
GOOGLE_REFRESH_TOKEN=

# The calendar that is checked and booked into. For the main calendar of a Google account
# this is the account's email address.
GOOGLE_CALENDAR_ID=

# Optional. One fixed address that Google emails about each new call request. It only works
# when it is a different address from the Google account that owns the calendar, which is one
# reason to run bookings from a dedicated account. Leave empty for no emails at all.
GOOGLE_NOTIFY_EMAIL=
