---
// "Before and after" on the language school case study (Figma 48:51 EN, 91:257 BG, 72:77 phone):
// the old site and the new one in one frame, wiped by a draggable handle, on two tabs
// (DESKTOP and PHONE). Each tab is one <Compare>; see Compare.astro for the slider itself.
//
// The images are full-page captures of both homepages, redacted IN THE PAGE before the
// screenshot (logo → Redacted badge, identifying text rewritten or hidden, client photos →
// stock photos), per REDACTION.md. The capture scripts and the unredacted pages are private and
// are not in this repo. Never replace these with a bare capture.
//   before-desktop-full.png  old site, 1440 wide at 2x, resized to 2688 wide (1344 CSS px)
//   after-desktop-full.png   new site, same
//   before-phone-full.png    old site, 390 wide at 3x, resized to 780 wide (2x)
//   after-phone-full.png     new site, same
// Keep every side under 16383px: WebP cannot hold more, which is why the phone pair is 2x.
import Screens from '../Screens.astro';
import Compare from './Compare.astro';
import type { CaseContent } from '../../../content/case';
import type { Lang } from '../../../i18n';
import beforeDesktop from '../../../assets/case/school/before-desktop-full.png';
import afterDesktop from '../../../assets/case/school/after-desktop-full.png';
import beforePhone from '../../../assets/case/school/before-phone-full.png';
import afterPhone from '../../../assets/case/school/after-phone-full.png';

interface Props {
  lang: Lang;
  t: CaseContent['screens'];
}
const { t } = Astro.props;
const c = t.compare!;
---

<Screens t={t}>
  <Compare
    slot="desktop"
    variant="desktop"
    before={beforeDesktop}
    after={afterDesktop}
    alt={{ before: t.alt.before, after: t.alt.after }}
    c={c}
  />
  <Compare
    slot="phone"
    variant="phone"
    before={beforePhone}
    after={afterPhone}
    alt={{ before: t.alt.beforePhone, after: t.alt.afterPhone }}
    c={c}
  />
</Screens>
