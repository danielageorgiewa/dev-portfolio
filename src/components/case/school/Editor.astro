---
// "The editor" on the language school case study, between "What changed" and "Results"
// (Figma 129:35 EN, 129:95 BG, 129:155 phone): a heading, a paragraph and the CMS frame.
//
// The frame plays the CMS recording: the course title is typed, the live preview follows, the
// title is deleted again. It was captured from the staging admin at 2x (2112 x 1188) with the
// city already swapped in the page ("в Шумен"), the school logo hidden in the page and the
// Redacted badge baked into every frame. Files: public/video/cms-live-preview.{webm,mp4} and
// the poster (the first frame, title typed) next to them. `data-autoplay-inview` plays it muted
// on loop while in view; with JavaScript off the poster shows.
//
// Set `recording` to undefined to fall back to the Figma still (129:68 at 2x, 129:188 at 4x for
// phone). The hidden "Recording (animated GIF)" layer inside that Figma frame still shows the
// real city: never export, download or publish it.
import ScreenShot from '../ScreenShot.astro';
import type { CaseContent } from '../../../content/case';
import type { Lang } from '../../../i18n';
import cms from '../../../assets/case/school/cms.png';
import cmsPhone from '../../../assets/case/school/cms-phone.png';

interface Props {
  lang: Lang;
  t: CaseContent;
}
const t = Astro.props.t.editor!;

const recording = {
  webm: '/video/cms-live-preview.webm',
  mp4: '/video/cms-live-preview.mp4',
  poster: '/video/cms-live-preview-poster.webp',
} as { webm?: string; mp4?: string; poster: string } | undefined;
---

<section class="editor">
  <div class="wrap editor__inner">
    <p class="eyebrow">{t.kicker}</p>
    <h2 class="editor__heading display" set:html={t.heading} />
    <p class="editor__text body-large">{t.text}</p>
    <div class="editor__media" data-reveal>
      {
        recording ? (
          <video
            data-autoplay-inview
            muted
            loop
            playsinline
            preload="none"
            poster={recording.poster}
            width="1344"
            height="756"
            aria-label={t.alt}
          >
            {recording.webm && <source src={recording.webm} type="video/webm" />}
            {recording.mp4 && <source src={recording.mp4} type="video/mp4" />}
          </video>
        ) : (
          <ScreenShot
            shot={{ src: cms, width: 1344, height: 756 }}
            phone={{ src: cmsPhone, width: 350, height: 197 }}
            alt={t.alt}
            openLabel={t.openLabel}
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .editor__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: flex-start;
    padding-top: 130px;
    padding-bottom: 130px;
  }
  .editor__heading {
    font-size: calc(72 * var(--u) * var(--case-display, 1));
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .editor__text {
    width: min(640px, 100%);
    color: var(--text-secondary);
  }
  .editor__media {
    width: 100%;
    /* The 1px border is part of the exported frame. */
    border-radius: calc(16 * var(--u));
    box-shadow: 0 24px 48px -12px rgb(46 38 36 / 0.12);
    overflow: clip;
  }
  .editor__media :global(.shot) {
    background: var(--bg-paper);
  }
  .editor__media video {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 767.98px) {
    .editor__inner {
      gap: 24px;
      padding-top: 72px;
      padding-bottom: 72px;
    }
    .editor__heading {
      font-size: calc(40 * var(--u) * var(--case-display-phone, 1));
    }
    .editor__text {
      font-size: 17px;
      line-height: 28px;
    }
    .editor__media {
      border-radius: calc(10 * var(--u));
    }
  }
</style>
