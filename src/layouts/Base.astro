---
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/motion.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, LANGS, href, type Lang } from '../i18n';
// The heading fonts are preloaded: the page heading is the largest paint on every page.
import serifEn from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifEnItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import serifBg from '@fontsource/cormorant/files/cormorant-cyrillic-500-normal.woff2?url';
import serifBgItalic from '@fontsource/cormorant/files/cormorant-cyrillic-500-italic.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix: '' | 'cv' | 'work/<slug>'. */
  page?: string;
  /** Absolute path of the Open Graph image for this page. */
  ogImage?: string;
  /** 'reveal' = the glass header slides down after the hero (home); 'fixed' = always visible. */
  header?: 'reveal' | 'fixed' | 'none';
  footer?: boolean;
  bodyClass?: string;
  /** Keep the page out of search results and the sitemap (404). */
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  page = '',
  // One image per page, generated by scripts/build-og.mjs: /og/en.png, /og/en-cv.png, /og/en-work-<slug>.png
  ogImage = `/og/${lang}${page ? `-${page.replace(/\//g, '-')}` : ''}.png`,
  header = 'fixed',
  footer = true,
  bodyClass,
  noindex = false,
} = Astro.props;

const preloadFonts = lang === 'bg' ? [serifBg, serifBgItalic] : [serifEn, serifEnItalic];
const canonical = new URL(href(lang, page), SITE_URL).href;
const og = new URL(ogImage, SITE_URL).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, page), SITE_URL).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(href('en', page), SITE_URL).href} />}
    {preloadFonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/icon.png" type="image/png" />
    <meta name="theme-color" content="#f2f0ed" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daniela Georgieva" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      /* Motion bootstrap: `js` for script-only styles; `js-intro` covers the load animations
         from the first paint until scripts/motion starts them, or for 3s at most. */
      (function (c) {
        c.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          c.add('js-intro');
          setTimeout(function () { c.remove('js-intro'); }, 3000);
        }
      })(document.documentElement.classList);
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Fragment set:html={'<!-- dg{l3ts_t4lk} -->'} />
    <a class="skip-link" href="#main">{lang === 'bg' ? 'Към съдържанието' : 'Skip to content'}</a>
    {header !== 'none' && <SiteHeader lang={lang} page={page} mode={header} />}
    <main id="main">
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
